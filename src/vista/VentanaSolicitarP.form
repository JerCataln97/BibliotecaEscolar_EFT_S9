        </constraints>
        <properties/>
      </component>
      <component id="a5f95" class="javax.swing.JButton" binding="btnSolicitarP">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
